Windows Registry Editor Version 5.00

; Force-install Devin Balance Guard from the self-hosted update server.
; Works in Chrome, Edge (use the Edge key block below) and other Chromium
; browsers WITHOUT enabling Developer mode. Run by double-clicking the .reg
; file (admin rights required) and then fully restart the browser.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="gdobkpjnopnafcbnhmfanccelegodchc;https://mikhailg517.github.io/devin/updates.xml"

; --- Microsoft Edge: uncomment the block below instead ---
; [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
; "1"="gdobkpjnopnafcbnhmfanccelegodchc;https://mikhailg517.github.io/devin/updates.xml"
